{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixInspo DJ",
  "version": "0.3.2",
  "identifier": "com.peterflanagan.mixinspodj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MixInspo DJ",
        "width": 410,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MkUyMjYyMTgyMjhBQjMKUldTemlpSVlZaUl1ZEJkcUNxcVNYWU9TYUVyZ1Fsdm5OUmI4OTNLOUROaVNyenJWYlVVY2tvVW4K",
      "endpoints": [
        "https://github.com/peterflanagan94-arch/mixinspodj/releases/latest/download/latest.json"
      ]
    }
  }
}
